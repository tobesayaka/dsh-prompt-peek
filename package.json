{
  "name": "dsh-prompt-peek",
  "version": "0.1.1",
  "type": "module",
  "description": "Shell-style prompt recall with a Markdown answer preview for the DeepSeek Harness web composer.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobesayaka/dsh-prompt-peek.git"
  },
  "homepage": "https://github.com/tobesayaka/dsh-prompt-peek#readme",
  "bugs": {
    "url": "https://github.com/tobesayaka/dsh-prompt-peek/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "prompt-history",
    "composer",
    "markdown"
  ],
  "scripts": {
    "check": "node --check client.js && node --check index.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
