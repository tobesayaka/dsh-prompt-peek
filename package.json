{
  "name": "dsh-prompt-peek",
  "version": "1.0.0",
  "type": "module",
  "description": "Shell-style prompt recall with a Markdown answer preview for the DeepSeek Harness web composer.",
  "icon": "./assets/icon.svg",
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobesayaka/dsh-prompt-peek.git"
  },
  "homepage": "https://github.com/tobesayaka/dsh-prompt-peek#readme",
  "bugs": {
    "url": "https://github.com/tobesayaka/dsh-prompt-peek/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "prompt-history",
    "composer",
    "markdown"
  ],
  "main": "./src/index.js",
  "scripts": {
    "check": "node --check src/client.js && node --check src/index.js",
    "test": "node --test test/*.test.mjs"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "src/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "assets/icon.svg",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "docs/REGRESSIONS.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
